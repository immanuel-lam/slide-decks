{
  "name": "slide-decks",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/*.test.mjs",
    "validate:decks": "node scripts/validate-decks.mjs",
    "build": "npm run validate:decks && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "check": "npm run lint && npm test && npm run check:theme && npm run build",
    "export": "node scripts/export-deck.mjs",
    "check:theme": "node scripts/check-theme.mjs"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "description": "Prompt-to-deck presentation engine: React slides on a fixed 16:9 canvas, a layout kit, presenter mode and timed speaker notes.",
